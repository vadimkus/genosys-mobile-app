{
  "name": "genosys-mobile-app",
  "version": "1.10.4",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "@react-native-community/datetimepicker"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "scripts": {
    "start": "EXPO_USE_POLLING=1 expo start",
    "android": "EXPO_USE_POLLING=1 expo start --android",
    "ios": "EXPO_USE_POLLING=1 expo start --ios",
    "web": "EXPO_USE_POLLING=1 expo start --web",
    "build:android:dev": "eas build --platform android --profile development:android",
    "build:android:preview": "eas build --platform android --profile preview:android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "android:assemble:release": "cd android && ./gradlew assembleRelease",
    "android:bundle:release": "cd android && ./gradlew bundleRelease",
    "sync:runtime": "node scripts/sync-runtime-version.js",
    "build:android:production": "npm run sync:runtime && eas build --platform android --profile production:android",
    "build:ios:production": "npm run sync:runtime && eas build --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "screenshots": "bash scripts/capture-appstore-screenshots.sh",
    "screenshots:interactive": "bash scripts/capture-screenshots-interactive.sh",
    "screenshots:russian": "bash scripts/capture-russian-screenshots.sh",
    "smoke:pricing-display": "node scripts/smoke-pricing-display.js",
    "smoke:cart-pricing-contract": "tsx scripts/smoke-cart-pricing-contract.js",
    "smoke:order-payload-pricing-contract": "tsx scripts/smoke-order-payload-pricing-contract.js",
    "smoke:orders-repository": "tsx scripts/smoke-orders-repository.js",
    "verify:splash": "node scripts/verify-splash-sync.js",
    "verify:release": "npm run verify:splash && npm run smoke:pricing-display && npm run smoke:cart-pricing-contract && npm run smoke:order-payload-pricing-contract && npm run smoke:orders-repository"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@sentry/react-native": "~7.2.0",
    "@stripe/stripe-react-native": "0.50.3",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.11",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.12",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-speech-recognition": "^3.1.0",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-refresh": "^0.18.0",
    "web-streams-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
