{
  "name": "genosys-mobile-app",
  "version": "1.11.0",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "@react-native-community/datetimepicker"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "scripts": {
    "start": "EXPO_USE_POLLING=1 expo start",
    "android": "EXPO_USE_POLLING=1 expo start --android",
    "ios": "EXPO_USE_POLLING=1 expo start --ios",
    "web": "EXPO_USE_POLLING=1 expo start --web",
    "build:android:dev": "eas build --platform android --profile development:android",
    "build:android:preview": "eas build --platform android --profile preview:android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "android:assemble:release": "cd android && ./gradlew assembleRelease",
    "android:bundle:release": "cd android && ./gradlew bundleRelease",
    "sync:runtime": "node scripts/sync-runtime-version.js",
    "build:android:production": "npm run sync:runtime && eas build --platform android --profile production:android",
    "build:ios:production": "npm run sync:runtime && eas build --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "screenshots": "bash scripts/capture-appstore-screenshots.sh",
    "screenshots:interactive": "bash scripts/capture-screenshots-interactive.sh",
    "screenshots:russian": "bash scripts/capture-russian-screenshots.sh",
    "smoke:pricing-display": "node scripts/smoke-pricing-display.js",
    "smoke:cart-pricing-contract": "tsx scripts/smoke-cart-pricing-contract.js",
    "smoke:order-payload-pricing-contract": "tsx scripts/smoke-order-payload-pricing-contract.js",
    "smoke:orders-repository": "tsx scripts/smoke-orders-repository.js",
    "verify:splash": "node scripts/verify-splash-sync.js",
    "verify:release": "npm run verify:splash && npm run smoke:pricing-display && npm run smoke:cart-pricing-contract && npm run smoke:order-payload-pricing-contract && npm run smoke:orders-repository"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@sentry/react-native": "~7.11.0",
    "@stripe/stripe-react-native": "0.64.0",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.0",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.0",
    "expo-auth-session": "~57.0.2",
    "expo-camera": "~57.0.1",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-manipulator": "~57.0.2",
    "expo-image-picker": "~57.0.2",
    "expo-linking": "~57.0.2",
    "expo-local-authentication": "~57.0.0",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.6",
    "expo-video": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-refresh": "^0.18.0",
    "web-streams-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
