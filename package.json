{
  "name": "genosys-mobile-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 8085 --offline",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "analyze": "node scripts/analyze-bundle.js",
    "analyze-bundle": "npx react-native-bundle-visualizer",
    "build:analyze": "expo build --type apk --analyze",
    "performance": "node scripts/analyze-bundle.js",
    "docs": "node scripts/generate-docs.js",
    "quality": "npm run lint && npm run format:check && npm run test:ci"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.8",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/stack": "^7.4.9",
    "@shopify/flash-list": "2.0.2",
    "axios": "^1.12.2",
    "expo": "~54.0.13",
    "expo-background-fetch": "^14.0.7",
    "expo-constants": "^18.0.9",
    "expo-device": "^8.0.9",
    "expo-file-system": "^19.0.17",
    "expo-linking": "^8.0.8",
    "expo-network": "^8.0.7",
    "expo-notifications": "^0.32.12",
    "expo-sqlite": "^16.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-task-manager": "^14.0.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-app-state": "^1.0.4",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-performance": "^5.1.4",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^30.2.0",
    "jest-expo": "^54.0.12",
    "prettier": "^3.6.2",
    "react-test-renderer": "^19.2.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
