{
  "expo": {
    "name": "Genosys UAE",
    "owner": "vadimkus",
    "slug": "genosys-mobile-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/app-icon-1024-native-matched.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ae.genosys.app",
      "buildNumber": "40",
      "usesAppleSignIn": true,
      "icon": "./assets/AppIcon.icon",
      "associatedDomains": [
        "applinks:genosys.ae",
        "applinks:www.genosys.ae"
      ],
      "entitlements": {
        "com.apple.developer.in-app-payments": [
          "merchant.ae.genosys.app"
        ]
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "infoPlist": {
        "CFBundleDisplayName": "Genosys UAE",
        "NSFaceIDUsageDescription": "This app uses Face ID for secure and convenient authentication to access your Genosys account.",
        "NSSpeechRecognitionUsageDescription": "Genosys uses speech recognition for voice search to help you find products quickly.",
        "NSMicrophoneUsageDescription": "Genosys uses the microphone for voice search to help you find products by speaking.",
        "NSCameraUsageDescription": "Genosys uses the camera to take a profile photo.",
        "NSPhotoLibraryUsageDescription": "Genosys uses your photo library to let you choose a profile photo.",
        "NSPhotoLibraryAddUsageDescription": "Genosys can save your profile photo to your photo library.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.998688135686-qmhvfcksth50r9ukk0pefqu1r7cqil73"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.genosys.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-1024-pwa-flat-no-alpha.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "genosys.ae",
              "pathPrefix": "/products"
            },
            {
              "scheme": "https",
              "host": "genosys.ae",
              "pathPrefix": "/cart"
            },
            {
              "scheme": "https",
              "host": "genosys.ae",
              "pathPrefix": "/orders"
            },
            {
              "scheme": "https",
              "host": "genosys.ae",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "genosys.ae",
              "pathPrefix": "/favorites"
            },
            {
              "scheme": "https",
              "host": "genosys.ae",
              "pathPrefix": "/skin-recommendation"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-apple-authentication",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.ae.genosys.app"
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "genosys",
    "extra": {
      "supportUrl": "https://genosys.ae",
      "privacyPolicyUrl": "https://genosys.ae/privacy-policy",
      "router": {},
      "eas": {
        "projectId": "b874a5c1-c47e-4c4e-9286-42e431978d51"
      }
    },
    "sdkVersion": "54.0.0"
  }
}
