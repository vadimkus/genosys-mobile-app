{
  "expo": {
    "name": "Genosys",
    "slug": "genosys-mobile-app", 
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.genosys.mobile"
    },
    "android": {
      "package": "com.genosys.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "genosys",
    "sdkVersion": "54.0.0"
  }
}
