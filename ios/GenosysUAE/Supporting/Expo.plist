<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iOS Expo Updates config.

  Runtime is synced from app.json expo.version by scripts/sync-runtime-version.js.
  iOS production builds run that script before EAS build so this plist and
  Expo's appVersion runtime policy stay aligned.

  See docs/OTA_UPDATES.md for release workflow.
-->
<plist version="1.0">
  <dict>
    <key>EXUpdatesCheckOnLaunch</key>
    <string>ALWAYS</string>
    <key>EXUpdatesEnabled</key>
    <true/>
    <key>EXUpdatesLaunchWaitMs</key>
    <integer>5000</integer>
    <key>EXUpdatesURL</key>
    <string>https://u.expo.dev/b874a5c1-c47e-4c4e-9286-42e431978d51</string>
    <key>EXUpdatesRuntimeVersion</key>
    <string>1.9.0</string>
  </dict>
</plist>